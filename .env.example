# Copy to .env for local dev, or set these as environment variables on Render.
# Never commit the real .env file — it is already in .gitignore.

# --- Database (Render Postgres free tier) ---
DATABASE_URL="postgresql://user:password@host:5432/sec_whatsapp?schema=public"

# --- AI provider ---
# One Google key powers both conversation orchestration (replacing AWS Bedrock for this
# POC) and the search-grounding tool invoked only by the grounding router (FR-D05) — see
# ADR-006. The two roles run as separate, isolated model calls (lib/conversation/
# orchestrator.ts vs grounding.ts); Gemini does not support mixing googleSearch with
# custom function declarations in one call.
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Meta WhatsApp Cloud API (free developer test number — see ADR-003) ---
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
# The dialable test number Meta assigned you (digits only, no +), used to build wa.me links.
META_PHONE_NUMBER_DISPLAY=""
META_WABA_ID=""
META_APP_SECRET=""
# Arbitrary string you also paste into the Meta App Dashboard webhook config.
META_VERIFY_TOKEN="change-me-webhook-verify-token"

# --- Signing ---
# Used for DIY handoff tokens (FR-F01) and the admin/agent console session cookie.
JWT_SECRET="change-me-32-byte-random-secret"

# --- Deployment ---
# Public base URL of this deployed service, used to build the QR redirect links and
# the Meta webhook callback URL. Set to the Render URL once deployed.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Feature flags (FR-E04 — Tier 1 must be fully disableable without redeploy) ---
FEATURE_TIER1_ELIGIBILITY_ENABLED="true"

# --- Seed / demo ---
# Password for the single seeded admin user created by `prisma/seed.ts`.
SEED_ADMIN_EMAIL="admin@avanse-sec.demo"
SEED_ADMIN_PASSWORD="change-me"
